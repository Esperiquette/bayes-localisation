     "shell.execute_reply": "2026-11-25T11:38:13.681981Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "outlier rate | coverage, sensor 0.25 | coverage, sensor 0.60\n"
     ]
    },
    {
     "name": "stdout",
